---
import BaseLayout from './BaseLayout.astro';
import ModuleSidebar from '../components/course/ModuleSidebar.astro';
import LessonTOC from '../components/course/LessonTOC.astro';
import Breadcrumbs from '../components/course/Breadcrumbs.astro';
import LessonProgress from '../components/course/LessonProgress.astro';
import KeyPoints from '../components/learning/KeyPoints';
import LessonNotes from '../components/learning/LessonNotes';
import type { CollectionEntry } from 'astro:content';
import { getModuleById } from '../data/modules';
import { quizQuestions } from '../data/quizzes';
import { flashcards } from '../data/flashcards';
import { plural, lessonsLabel } from '../lib/plural';
import CheckpointCard from '../components/course/CheckpointCard.astro';
import { getStageById, type Checkpoint } from '../data/process';

interface LessonRef {
  title: string;
  slug: string;
  moduleId: string;
  moduleTitle: string;
}
interface Props {
  lesson: CollectionEntry<'lessons'>;
  headings: { depth: number; slug: string; text: string }[];
  prevLesson?: LessonRef;
  nextLesson?: LessonRef;
  position: {
    lessonInModule: number;
    lessonsInModule: number;
    moduleIndex: number;
    modulesInCourse: number;
    lessonInCourse: number;
    lessonsInCourse: number;
  };
  moduleLessons: LessonRef[];
  courseId: string;
  courseTitle: string;
  /** Контрольная точка после текущего модуля — показывается на границе модулей */
  checkpoint?: Checkpoint;
  nextCourse?: { id: string; title: string; kind: string; href?: string };
}

const {
  lesson, headings, prevLesson, nextLesson, position, moduleLessons,
  courseId, courseTitle, checkpoint, nextCourse,
} = Astro.props;
const module = getModuleById(lesson.data.module);
const base = import.meta.env.BASE_URL;

// Related quizzes and flashcards for this module
const moduleQuizCount = quizQuestions.filter(q => q.moduleId === lesson.data.module).length;
const moduleCardCount = flashcards.filter(f => f.moduleId === lesson.data.module).length;

const stage = module?.stage ? getStageById(module.stage) : undefined;
const crossesModule = !!nextLesson && nextLesson.moduleId !== lesson.data.module;
const coursePct = Math.round((position.lessonInCourse / position.lessonsInCourse) * 100);
const currentSlug = lesson.slug.split('/').pop();
const nextCourseHref = nextCourse
  ? nextCourse.kind === 'simulation' ? `${base}${nextCourse.href}` : `${base}courses/${nextCourse.id}`
  : undefined;
---

<BaseLayout title={lesson.data.title} description={lesson.data.summary}>
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex gap-8 py-8">
      <!-- Left Sidebar -->
      <aside class="hidden lg:block w-64 flex-shrink-0">
        <div class="sticky top-24 space-y-6">
          <ModuleSidebar currentModule={lesson.data.module} currentLesson={lesson.id} />

          <!-- Quick links for this module -->
          {(moduleQuizCount > 0 || moduleCardCount > 0) && (
            <div class="rounded-xl border border-stone-200 dark:border-stone-800 p-4 space-y-2">
              <div class="text-xs font-semibold text-stone-400 dark:text-stone-500 uppercase tracking-wide mb-3">Тренировка</div>
              {moduleCardCount > 0 && (
                <a href={`${base}study/${lesson.data.module}`}
                  class="flex items-center gap-2 text-sm text-stone-600 dark:text-stone-400 hover:text-wine-700 dark:hover:text-wine-400 transition-colors">
                  <span>🃏</span>
                  <span>Флэш-карты ({moduleCardCount})</span>
                </a>
              )}
              {moduleQuizCount > 0 && (
                <a href={`${base}quiz/${lesson.data.module}`}
                  class="flex items-center gap-2 text-sm text-stone-600 dark:text-stone-400 hover:text-wine-700 dark:hover:text-wine-400 transition-colors">
                  <span>❓</span>
                  <span>Квиз ({moduleQuizCount} {plural(moduleQuizCount, ['вопрос', 'вопроса', 'вопросов'])})</span>
                </a>
              )}
            </div>
          )}
        </div>
      </aside>

      <!-- Main content -->
      <article class="flex-1 min-w-0 max-w-3xl">
        <Breadcrumbs module={module} lessonTitle={lesson.data.title} />

        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-stone-500 dark:text-stone-400 mb-3">
            <span>Модуль {position.moduleIndex} из {position.modulesInCourse}</span>
            <span aria-hidden="true">·</span>
            <span>Урок {position.lessonInModule} из {position.lessonsInModule}</span>
            {stage && (
              <>
                <span aria-hidden="true">·</span>
                <a href={`${base}process#${stage.id}`} class="hover:text-wine-700 dark:hover:text-wine-400 hover:underline" title="Место в технологической цепочке">
                  {stage.icon} {stage.title.replace(/^Стадия \d+\. /, '')}
                </a>
              </>
            )}
          </div>
          <div class="h-1 rounded-full bg-stone-200 dark:bg-stone-800 mb-4 overflow-hidden" role="progressbar" aria-label={`Позиция в курсе «${courseTitle}»`} aria-valuenow={position.lessonInCourse} aria-valuemin={1} aria-valuemax={position.lessonsInCourse}>
            <div class="h-full bg-wine-600/70" style={`width:${coursePct}%`}></div>
          </div>
          <div class="flex flex-wrap gap-2 mb-3">
            <span class={`text-xs px-2 py-0.5 rounded-full font-medium
              ${lesson.data.difficulty === 'базовый' ? 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300' :
                lesson.data.difficulty === 'средний' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300' :
                'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300'}`}>
              {lesson.data.difficulty}
            </span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-400">
              ≈{lesson.data.durationMin} мин
            </span>
            {lesson.data.status === 'черновик' && (
              <span class="text-xs px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300">
                черновик
              </span>
            )}
            {lesson.data.prerequisite && (
              <a
                href={`${base}course/${lesson.data.prerequisite}`}
                class="text-xs px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 dark:bg-blue-950/30 dark:text-blue-400 hover:underline"
              >
                ← Сначала: {lesson.data.prerequisite.split('/').pop()}
              </a>
            )}
          </div>

          <h1 class="text-3xl font-bold text-stone-900 dark:text-stone-100 mb-3">{lesson.data.title}</h1>
          <p class="text-lg text-stone-600 dark:text-stone-400">{lesson.data.summary}</p>

          {lesson.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-4">
              {lesson.data.tags.map(tag => (
                <a href={`${base}glossary?q=${encodeURIComponent(tag)}`} class="text-xs px-2 py-1 rounded-md bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-400 hover:bg-wine-50 dark:hover:bg-wine-950/30 hover:text-wine-700 dark:hover:text-wine-400 transition-colors">
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <details class="lg:hidden mb-6 rounded-xl border border-stone-200 dark:border-stone-800">
          <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-stone-700 dark:text-stone-300">
            {module?.icon} {module?.title}: {lessonsLabel(position.lessonsInModule)}
          </summary>
          <ol class="px-4 pb-3 space-y-1">
            {moduleLessons.map((l, i) => (
              <li>
                <a
                  href={`${base}course/${l.slug}`}
                  aria-current={l.slug.endsWith(`/${currentSlug}`) ? 'page' : undefined}
                  class={`block text-sm py-1 ${l.slug.endsWith(`/${currentSlug}`) ? 'font-semibold text-wine-700 dark:text-wine-400' : 'text-stone-600 dark:text-stone-400 hover:text-wine-700'}`}
                >
                  {i + 1}. {l.title}
                </a>
              </li>
            ))}
          </ol>
        </details>

        <div class="prose-wine" data-pagefind-body>
          <slot />
        </div>

        <!-- Key Points, Mnemonic, Self-Check -->
        {lesson.data.keyPoints && lesson.data.keyPoints.length > 0 && (
          <KeyPoints
            client:visible
            points={lesson.data.keyPoints}
            mnemonic={lesson.data.mnemonic}
            selfCheck={lesson.data.selfCheck}
          />
        )}

        {lesson.data.sources && lesson.data.sources.length > 0 && (
          <section class="mt-10 pt-6 border-t border-stone-200 dark:border-stone-800">
            <h3 class="text-sm font-semibold text-stone-500 dark:text-stone-400 uppercase tracking-wide mb-3">Источники</h3>
            <ul class="space-y-1">
              {lesson.data.sources.map(src => (
                <li class="text-sm text-stone-600 dark:text-stone-400 flex gap-2">
                  <span class="text-stone-400">—</span>
                  <span>{src}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Notes -->
        <LessonNotes client:visible lessonId={lesson.id} />

        <LessonProgress lessonId={lesson.id} />

        <!-- Quick access to quiz/flashcards -->
        {(moduleQuizCount > 0 || moduleCardCount > 0) && (
          <div class="mt-6 p-4 rounded-xl bg-stone-50 dark:bg-stone-900 border border-stone-200 dark:border-stone-800">
            <p class="text-sm font-medium text-stone-700 dark:text-stone-300 mb-3">
              Закрепите знания по модулю «{module?.title}»:
            </p>
            <div class="flex flex-wrap gap-2">
              {moduleCardCount > 0 && (
                <a href={`${base}study/${lesson.data.module}`} class="btn-secondary text-xs">
                  🃏 Флэш-карты ({moduleCardCount})
                </a>
              )}
              {moduleQuizCount > 0 && (
                <a href={`${base}quiz/${lesson.data.module}`} class="btn-primary text-xs">
                  ❓ Пройти квиз ({moduleQuizCount} {plural(moduleQuizCount, ['вопрос', 'вопроса', 'вопросов'])})
                </a>
              )}
            </div>
          </div>
        )}

        <!-- Контрольная точка на границе модулей -->
        {checkpoint && (
          <div class="mt-10">
            <p class="text-sm font-medium text-stone-700 dark:text-stone-300 mb-3">
              {crossesModule ? 'Перед следующим модулем — контрольная точка:' : 'Контрольная точка после модуля:'}
            </p>
            <CheckpointCard checkpoint={checkpoint} />
          </div>
        )}

        <!-- Навигация между уроками -->
        <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3" aria-label="Соседние уроки">
          {prevLesson ? (
            <a href={`${base}course/${prevLesson.slug}`} class="group min-w-0 rounded-xl border border-stone-200 dark:border-stone-800 p-4 hover:border-wine-300 dark:hover:border-wine-700 transition-colors">
              <span class="block text-xs text-stone-500 dark:text-stone-400 mb-1">← Предыдущий урок</span>
              <span class="block font-medium text-stone-800 dark:text-stone-200 line-clamp-2 group-hover:text-wine-700 dark:group-hover:text-wine-400">{prevLesson.title}</span>
            </a>
          ) : <div class="hidden sm:block" />}

          {nextLesson && (
            <a
              href={`${base}course/${nextLesson.slug}`}
              data-complete-on-click
              class="group min-w-0 rounded-xl border border-wine-200 dark:border-wine-800 bg-wine-50/60 dark:bg-wine-950/20 p-4 text-right hover:border-wine-400 transition-colors"
            >
              <span class="block text-xs text-wine-700 dark:text-wine-400 mb-1">
                {crossesModule ? `Следующий модуль: ${nextLesson.moduleTitle} →` : 'Следующий урок →'}
              </span>
              <span class="block font-medium text-stone-800 dark:text-stone-200 line-clamp-2 group-hover:text-wine-700 dark:group-hover:text-wine-400">{nextLesson.title}</span>
            </a>
          )}
        </nav>

        <!-- Конец курса: не тупик, а следующие шаги -->
        {!nextLesson && (
          <section class="mt-8 rounded-xl border border-emerald-200 dark:border-emerald-900 bg-emerald-50/60 dark:bg-emerald-950/20 p-5" aria-labelledby="course-end-title">
            <h2 id="course-end-title" class="font-semibold text-stone-800 dark:text-stone-100 mb-1">Это последний урок курса «{courseTitle}»</h2>
            <p class="text-sm text-stone-600 dark:text-stone-400 mb-4">Отметьте урок пройденным и выберите, куда двигаться дальше.</p>
            <div class="flex flex-wrap gap-2">
              {nextCourse && nextCourseHref && (
                <a href={nextCourseHref} data-complete-on-click class="btn-primary text-sm">
                  {nextCourse.kind === 'simulation' ? 'Применить в симуляторе' : `Следующий курс: ${nextCourse.title}`} →
                </a>
              )}
              <a href={`${base}courses/${courseId}`} data-complete-on-click class="btn-secondary text-sm">Программа курса</a>
              {stage && <a href={`${base}process`} data-complete-on-click class="btn-secondary text-sm">Навигатор по цепочке</a>}
              {moduleQuizCount > 0 && <a href={`${base}quiz/${lesson.data.module}`} data-complete-on-click class="btn-secondary text-sm">Квиз по модулю</a>}
            </div>
          </section>
        )}

        <script is:inline define:vars={{ lastLesson: {
          id: lesson.id,
          href: `${base}course/${lesson.data.module}/${currentSlug}`,
          title: lesson.data.title,
          moduleTitle: module?.title ?? '',
          courseId,
          courseTitle,
        } }}>
          // Запоминаем место остановки для «Продолжить» на главной и странице курса
          try {
            localStorage.setItem('last-lesson', JSON.stringify(Object.assign({}, lastLesson, { at: Date.now() })));
          } catch (e) {}
          // Переход дальше отмечает текущий урок пройденным: раньше прогресс
          // засчитывался только отдельной кнопкой, и счётчики оставались на нуле
          document.querySelectorAll('[data-complete-on-click]').forEach(function (a) {
            a.addEventListener('click', function () {
              try {
                var p = JSON.parse(localStorage.getItem('lesson-progress') || '{}');
                if (!p[lastLesson.id]) {
                  p[lastLesson.id] = true;
                  localStorage.setItem('lesson-progress', JSON.stringify(p));
                }
              } catch (e) {}
            });
          });
        </script>
      </article>

      <!-- Right TOC -->
      <aside class="hidden xl:block w-56 flex-shrink-0">
        <div class="sticky top-24">
          <LessonTOC headings={headings} />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
