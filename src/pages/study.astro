---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudyView from '../components/learning/StudyView.astro';
import { flashcards } from '../data/flashcards';

const validModules = [...new Set(flashcards.map((c) => c.moduleId))];
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Флэш-карты" description="Интервальное повторение — флэш-карты по виноделию">
  <StudyView />
</BaseLayout>

<!-- Старые ссылки вида study?module=so2 ведём на постоянный адрес модуля -->
<script is:inline define:vars={{ validModules, base }}>
  const m = new URLSearchParams(location.search).get('module');
  if (m && validModules.includes(m)) location.replace(base + 'study/' + m + '/');
</script>
