---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuizView from '../components/learning/QuizView.astro';
import { quizQuestions } from '../data/quizzes';

const validModules = [...new Set(quizQuestions.map((q) => q.moduleId))];
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Квиз" description="Проверка знаний по технологии виноделия в формате Сократа">
  <QuizView />
</BaseLayout>

<!-- Старые ссылки вида quiz?module=so2 ведём на постоянный адрес модуля -->
<script is:inline define:vars={{ validModules, base }}>
  const m = new URLSearchParams(location.search).get('module');
  if (m && validModules.includes(m)) location.replace(base + 'quiz/' + m + '/');
</script>
