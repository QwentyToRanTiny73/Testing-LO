---
// Контрольная точка между операциями: что проверить перед переходом дальше
// и какие развилки возможны. Компактная справочная карточка, не урок.
import type { Checkpoint, Severity } from '../../data/process';

interface Props {
  checkpoint: Checkpoint;
  /** compact — для страницы курса, full — для навигатора */
  variant?: 'compact' | 'full';
}

const { checkpoint, variant = 'compact' } = Astro.props as Props;

const SEV: Record<Severity, { label: string; dot: string; chip: string }> = {
  ok: {
    label: 'Норма',
    dot: 'bg-emerald-500',
    chip: 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300',
  },
  watch: {
    label: 'Внимание',
    dot: 'bg-amber-500',
    chip: 'bg-amber-50 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300',
  },
  risk: {
    label: 'Риск',
    dot: 'bg-red-500',
    chip: 'bg-red-50 text-red-800 dark:bg-red-950/40 dark:text-red-300',
  },
};
---

<section
  class="relative rounded-xl border border-dashed border-stone-300 dark:border-stone-700 bg-stone-50/70 dark:bg-stone-900/40 p-5"
  aria-label={`Контрольная точка: ${checkpoint.title}`}
>
  <div class="flex items-center gap-2 mb-1">
    <svg class="w-4 h-4 text-stone-400 flex-shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M10 2v16M10 18l-3-3M10 18l3-3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="text-[11px] uppercase tracking-wider text-stone-400 dark:text-stone-500">Контрольная точка</span>
  </div>

  <h3 class="font-semibold text-stone-800 dark:text-stone-200 mb-3">{checkpoint.title}</h3>

  <!-- Что должно сойтись -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5 mb-4">
    {checkpoint.gate.map((g) => (
      <div class="flex items-baseline gap-2 text-sm">
        <svg class="w-3.5 h-3.5 text-stone-400 flex-shrink-0 translate-y-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 8.5 6.5 12 13 4.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="text-stone-500 dark:text-stone-400">
          <span class="text-stone-700 dark:text-stone-300">{g.label}:</span> {g.value}
        </span>
      </div>
    ))}
  </div>

  <!-- Развилки -->
  <div class="space-y-2">
    {checkpoint.branches.map((b) => {
      const s = SEV[b.severity];
      return (
        <details class="group rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900">
          <summary class="flex items-start gap-2.5 p-3 cursor-pointer list-none">
            <span class={`w-2 h-2 rounded-full flex-shrink-0 mt-1.5 ${s.dot}`} aria-hidden="true"></span>
            <span class="flex-1 text-sm text-stone-700 dark:text-stone-300">{b.when}</span>
            <span class={`text-[10px] px-1.5 py-0.5 rounded whitespace-nowrap ${s.chip}`}>{s.label}</span>
            <svg class="w-4 h-4 text-stone-400 flex-shrink-0 mt-0.5 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="px-3 pb-3 pl-[1.85rem] space-y-1.5">
            <p class="text-sm text-stone-500 dark:text-stone-400">
              <span class="text-stone-400 dark:text-stone-500">Значит:</span> {b.means}
            </p>
            <p class="text-sm text-stone-700 dark:text-stone-300">
              <span class="text-stone-400 dark:text-stone-500">Действие:</span> {b.action}
            </p>
          </div>
        </details>
      );
    })}
  </div>

  {variant === 'full' && (
    <p class="text-xs text-stone-400 dark:text-stone-500 mt-3">
      Значения — ориентиры, требующие калибровки под сырьё, оборудование и регламент.
    </p>
  )}
</section>
