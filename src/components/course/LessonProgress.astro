---
interface Props {
  lessonId: string;
}
const { lessonId } = Astro.props;
---

<div class="mt-10 pt-6 border-t border-stone-200 dark:border-stone-800">
  <div class="flex items-center justify-between">
    <p class="text-sm text-stone-600 dark:text-stone-400">Вы изучили этот урок?</p>
    <button
      id="complete-btn"
      data-lesson-id={lessonId}
      class="btn-primary"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span class="complete-text">Отметить пройденным</span>
    </button>
  </div>
</div>

<script>
  import { isComplete, setComplete } from '../../lib/progress';

  const btn = document.getElementById('complete-btn') as HTMLButtonElement | null;
  if (btn) {
    const lessonId = btn.dataset.lessonId!;

    function updateBtn(completed: boolean) {
      const text = btn!.querySelector('.complete-text')!;
      const icon = btn!.querySelector('.check-icon')!;
      text.textContent = completed ? 'Пройдено ✓' : 'Отметить пройденным';
      icon.classList.toggle('hidden', !completed);
      btn!.classList.toggle('bg-green-700', completed);
      btn!.classList.toggle('hover:bg-green-800', completed);
      btn!.classList.toggle('bg-wine-700', !completed);
      btn!.classList.toggle('hover:bg-wine-800', !completed);
      btn!.setAttribute('aria-pressed', String(completed));
    }

    updateBtn(isComplete(lessonId));
    btn.addEventListener('click', () => {
      const done = !isComplete(lessonId);
      setComplete(lessonId, done);
      updateBtn(done);
    });
  }
</script>
